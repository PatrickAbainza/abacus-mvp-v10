# Abacus dashboard frontend — Next.js.
# Multi-stage: install deps, build the static-optimized app, then run the
# Next server. The app talks only to same-origin `/api/*`; the route handler
# reads its backend origins from runtime environment variables.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
COPY --chown=node:node --from=build /app ./
USER node
EXPOSE 3000
CMD ["npm", "start"]
